# ====================================================================
# BomaSphere PMS Server Configuration
# ====================================================================
PORT=3000
NODE_ENV=development

# ====================================================================
# Safaricom Daraja 3.0 M-Pesa Integration Credentials
# ====================================================================
# Set to 'production' for live payments, or 'sandbox' for developer testing
MPESA_ENV=sandbox

# Daraja 3.0 App Consumer Key & Consumer Secret from developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Business ShortCode (Paybill or Till Number)
# Default sandbox test Paybill is 174379
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa Online Passkey (from Daraja portal app settings)
# Default sandbox passkey is provided below for immediate testing
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Public Webhook Callback URL (where Safaricom posts real-time confirmation callbacks)
# Must be an HTTPS URL reachable from the internet
MPESA_CALLBACK_URL=https://rentalpropertymanagement.pages.dev/api/mpesa/callback


